{
  "expo": {
    "name": "Owoda",
    "slug": "owoda",
    "owner": "korvedion",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.owodalabs.owoda"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#93401F",
        "monochromeImage": "./assets/adaptive-icon.png"
      },
      "package": "com.owodalabs.owoda",
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      "expo-sharing",
      "expo-sqlite",
      "expo-status-bar",
      ["expo-splash-screen", {
        "image": "./assets/splash.png",
        "imageWidth": 200,
        "resizeMode": "contain",
        "backgroundColor": "#93401F"
      }]
    ],
    "scheme": "owoda",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "5bba43f2-6172-4105-be12-7d9204067a31"
      }
    }
  }
}
